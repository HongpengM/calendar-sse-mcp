# Server configuration
# Use 0.0.0.0 to accept connections from both 127.0.0.1 and localhost
SERVER_HOST=0.0.0.0
SERVER_PORT=27212
SERVER_TRANSPORT=streamable-http

# Launch Agent configuration
LAUNCH_AGENT_NAME=com.calendar-mcp
LOG_DIR=/tmp
AUTO_LOAD_AGENT=false

# Calendar app settings
DEFAULT_CALENDAR=Home
EVENT_DURATION_MINUTES=60

# Additional settings
DEBUG=false 